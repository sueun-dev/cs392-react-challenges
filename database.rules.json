{
  "rules": {
    ".read": true,
    "courses": {
      "$courseId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['term', 'number', 'meets', 'title'])",
        "term": { ".validate": "newData.isString()" },
        "number": { ".validate": "newData.isString()" },
        "meets": { ".validate": "newData.isString()" },
        "title": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
